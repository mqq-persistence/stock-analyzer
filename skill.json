{
  "name": "limit-up-analysis",
  "version": "1.0.0",
  "description": "涨停股分析 - 基于 AKShare 数据源筛选高质量涨停标的",
  "author": "Your Name",
  "license": "MIT",
  "repository": "https://github.com/your-username/stock-analyzer",
  "homepage": "https://github.com/your-username/stock-analyzer#readme",
  "tags": ["stock", "finance", "china", "akshare", "analysis"],
  "trigger_phrases": [
    "分析涨停股",
    "涨停股筛选",
    "封板强度分析",
